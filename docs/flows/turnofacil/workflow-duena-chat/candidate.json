      "tag": "rechazos sin orden fijo"
    },
    {
      "id": "guarda",
      "lane": "reg",
      "col": 4,
      "type": "database",
      "label": "Cita guardada",
      "sublabel": "queda lista para recordatorios"
    },
    {
      "id": "confirma",
      "lane": "reg",
      "col": 5,
      "type": "frontend",
      "icon": "success",
      "label": "Confirmación de guardado",
      "sublabel": "en menos de 10 s [ASUNCIÓN]",
      "tag": "+ aviso si la clienta se dio de baja"
    },
    {
      "id": "repetir",
      "lane": "regx",
      "col": 3,
      "type": "frontend",
      "icon": "failure",
      "label": "Pide repetir el mensaje",
      "sublabel": "falta dato · teléfono · fecha pasada"
    },
    {
      "id": "existe",
      "lane": "regx",
      "col": 4,
      "type": "frontend",
      "icon": "failure",
      "label": "Avisa: la cita ya existe",
      "sublabel": "mismo teléfono, día y hora"
    },
    {
      "id": "busca",
      "lane": "can",
      "col": 3,
      "type": "backend",
      "icon": "decision",
      "label": "Busca la cita",
      "sublabel": "nombre de la clienta + día y hora",
      "tag": "[DECISIÓN DEL DIAGRAMA]"
    },
    {
      "id": "cancelada",
      "lane": "can",
      "col": 4,
      "type": "database",
      "label": "Cita cancelada por la dueña",
      "sublabel": "también confirmada o ya cancelada",
      "tag": "[DECISIÓN DEL DIAGRAMA]"
    },
    {
      "id": "sinaviso",
      "lane": "can",
      "col": 5,
      "type": "backend",
      "icon": "stop",
      "label": "Sin más recordatorios",
      "sublabel": "no se avisa a la clienta"
    },
    {
      "id": "noencontro",
      "lane": "canx",
      "col": 3,
      "type": "frontend",
      "icon": "failure",
      "label": "Avisa: no se encontró",
      "tag": "[DECISIÓN DEL DIAGRAMA]"
    },
    {
      "id": "dia",
      "lane": "vis",
      "col": 3,
      "type": "backend",
      "icon": "calendar",
      "label": "Lee el día pedido",
      "sublabel": "sin día = mañana"
    },
    {
      "id": "listas",
      "lane": "vis",
      "col": 4,
      "type": "backend",
      "label": "Arma las dos listas",
      "sublabel": "confirmadas · sin confirmar",
      "tag": "[ASUNCIÓN] no probada"
    },
    {
      "id": "vista",
      "lane": "vis",
      "col": 5,
      "type": "frontend",
      "icon": "success",
      "label": "Recibe la vista",
      "sublabel": "en menos de 10 s [ASUNCIÓN]"
    },
    {
      "id": "nodia",
      "lane": "visx",
      "col": 3,
      "type": "frontend",
      "icon": "failure",
      "label": "Pide repetir el día",
      "sublabel": "no envía ninguna lista"
    },
    {
      "id": "nocitas",
      "lane": "visx",
      "col": 4,
      "type": "frontend",
      "icon": "neutral",
      "label": "Avisa: no hay citas",
      "sublabel": "para ese día"
    }
  ],
