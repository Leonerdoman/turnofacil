      "icon": "person",
      "label": "Dueña escribe al chat",
      "sublabel": "registrar · cancelar · vista"
    },
    {
      "id": "ignorado",
      "lane": "control",
      "col": 0,
      "type": "security",
      "icon": "stop",
      "label": "No se ejecuta",
      "sublabel": "y no se responde nada"
    },
    {
      "id": "numero",
      "lane": "control",
      "col": 1,
      "type": "security",
      "icon": "decision",
      "label": "¿Número registrado?",
      "sublabel": "un solo número por salón",
      "tag": "[PENDIENTE] cambio de número"
    },
    {
      "id": "accion",
      "lane": "control",
      "col": 2,
      "type": "backend",
      "icon": "decision",
      "label": "¿Qué acción pide?"
    },
    {
      "id": "revisa",
      "lane": "reg",
      "col": 3,
      "type": "backend",
      "icon": "decision",
      "label": "Revisa el registro",
