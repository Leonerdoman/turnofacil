          "label": "Control de acceso"
        },
        "backend": {
          "label": "Paso de TurnoFácil"
        },
        "database": {
          "label": "Cita guardada o cambiada"
        },
        "frontend": {
          "label": "Mensaje que recibe la dueña"
        }
      }
    }
  },
  "lanes": [
    {
      "id": "duena",
      "label": "Dueña"
    },
    {
      "id": "control",
      "label": "Control de número"
    },
    {
      "id": "reg",
      "label": "Registrar cita"
    },
    {
      "id": "regx",
      "label": "Registro rechazado",
